module(name = "os_images")

# Compliance and licensing toolchain
bazel_dep(name = "score_tooling", version = "3.0.2")
bazel_dep(name = "score_python_basics", version = "0.3.4")

# Formatting and linting helpers
bazel_dep(name = "score_format_checker", version = "0.1.1")

bazel_dep(
    name = "aspect_rules_lint",
    version = "2.9.1",
    dev_dependency = True,
)
bazel_dep(
    name = "buildifier_prebuilt",
    version = "10.1.0",
    dev_dependency = True,
)

# Rules used by the QEMU image definitions
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)

bazel_dep(name = "rules_pkg", version = "1.0.1")

# QEMU integration test framework
bazel_dep(name = "score_itf", version = "0.5.0", dev_dependency = True)
bazel_dep(name = "rules_python", version = "1.9.0", dev_dependency = True)

# TODO: Switch back to a released version once `--qemu-disk` is part of a tagged release.
git_override(
    module_name = "score_itf",
    commit = "38ae9a3dd98ccc7434e1f8b57ca4a3d2bac82e2f",
    remote = "https://github.com/eclipse-score/itf.git",
)

# Filesystem image rules, used to build the additional disk image attached to the
# QEMU targets via `--qemu-disk`.
bazel_dep(name = "score_rules_imagefs", version = "0.1.0", dev_dependency = True)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_linux_x86_64_ext4_toolchain",
    target_cpu = "x86_64",
    target_os = "linux",
    type = "ext4",
)
use_repo(imagefs, "score_linux_x86_64_ext4_toolchain")

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.defaults(python_version = "3.12")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

###############################################################################
#
# EBcLfSA fastdev archive used as base for the aarch64 QEMU image
#
###############################################################################
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "eb_corbos_toolkit_fastdev_archive",
    downloaded_file_path = "fastdev-ubuntu-ebclfsa-ebcl-qemuarm64.tar.gz",
    sha256 = "d84ffd33210a71a2fdd478fa25df3775f873a83d2fe158b56c5ed37da4265823",
    urls = ["https://github.com/elektrobit/eb_corbos_toolkit/releases/download/v2.0.0-beta3/fastdev-trixie-ebclfsa-ebcl-qemuarm64.tar.gz"],
)

###############################################################################
#
# EB corbos Toolkit sources used to build the aarch64 image from scratch
#
# Only the KAS configuration, the bundled Isar layers and the development
# container setup are used, see //ebclfsa_aarch64.
#
###############################################################################
new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "eb_corbos_toolkit",
    build_file_content = """
exports_files(["BUILD.bazel"])

filegroup(
    name = "sources",
    srcs = glob(["kas/**", "layers/**", ".devcontainer/**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "fe2cddbc01232e4b62accb9abab783c8ccf75ef7",  # v2.0.0-beta3
    remote = "https://github.com/Elektrobit/eb_corbos_toolkit.git",
)

###############################################################################
#
# Ubuntu minimal cloud image used as base for the x86_64 QEMU image
#
# Pinned to a dated release directory so the download stays reproducible. The
# minimal image is used instead of the full server image to reduce test times.
# The file uses the ".img" extension but is in fact a qcow2 image.
#
###############################################################################
http_file(
    name = "ubuntu_noble_minimal_cloudimg_amd64",
    downloaded_file_path = "ubuntu-24.04-minimal-cloudimg-amd64.img",
    sha256 = "3839f148c5a3b4a736e7dbb0af75594743fa5ebee2a202424ba1a32e5d3b5d2c",
    urls = ["https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261027/ubuntu-24.04-minimal-cloudimg-amd64.img"],
)

###############################################################################
#
# Raspberry Pi 4 boot firmware and U-Boot used by //platforms/rpi4
#
# The SD card image only carries the Pi4 GPU firmware, the device tree and
# U-Boot. U-Boot then provides a UEFI (EBBR) environment and boots the actual
# OS from a separate USB stick.
#
# The firmware files are pinned to a single raspberrypi/firmware commit so the
# download stays reproducible.
###############################################################################
RPI_FIRMWARE_COMMIT = "12eeaa12865869b07db760f4bbb7507ec6f1976c"

http_file(
    name = "rpi4_fw_start4_elf",
    downloaded_file_path = "start4.elf",
    sha256 = "3484b5ddc0f655e0e562680b7e2462ec21177763cc2d884b37d31e53b800bb02",
    urls = ["https://raw.githubusercontent.com/raspberrypi/firmware/%s/boot/start4.elf" % RPI_FIRMWARE_COMMIT],
)

http_file(
    name = "rpi4_fw_fixup4_dat",
    downloaded_file_path = "fixup4.dat",
    sha256 = "c571fe712649b66409a4834b06af39dcef8dca6727e3abc10c6043f02028b5e5",
    urls = ["https://raw.githubusercontent.com/raspberrypi/firmware/%s/boot/fixup4.dat" % RPI_FIRMWARE_COMMIT],
)

http_file(
    name = "rpi4_fw_bcm2711_rpi_4_b_dtb",
    downloaded_file_path = "bcm2711-rpi-4-b.dtb",
    sha256 = "75761b73c284e26623e4d1624bff13e67bce2ae620880efd81d6571a3739fcfb",
    urls = ["https://raw.githubusercontent.com/raspberrypi/firmware/%s/boot/bcm2711-rpi-4-b.dtb" % RPI_FIRMWARE_COMMIT],
)

# Prebuilt 64-bit U-Boot for the Raspberry Pi 4, taken from the Ubuntu
# `u-boot-rpi` package. The `deb` rule downloads and extracts the .deb; the
# binary is exposed as @u_boot_rpi_deb//:u-boot-bin (see third_party/uboot).
#
# Ubuntu 24.04 (noble) arm64 build; ships usr/lib/u-boot/rpi_arm64/u-boot.bin.
deb = use_repo_rule("//third_party:deb.bzl", "deb")

deb(
    name = "u_boot_rpi_deb",
    build = "//third_party/uboot:uboot.BUILD",
    sha256 = "ac1325244b9cb4d013555f1f6fdb11e38c28977388f7ccbf3fe4e4c273c2ea72",
    urls = ["https://ports.ubuntu.com/ubuntu-ports/pool/main/u/u-boot/u-boot-rpi_2025.10-0ubuntu0.24.04.4_arm64.deb"],
)

bazel_dep(
    name = "score_devcontainer",
    version = "1.12.0",
)
