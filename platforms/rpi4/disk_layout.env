#
# Configurable partition/image layout for the RPi4 U-Boot SD card image.
#
# This file is sourced by build_image.sh. Every value can also be overridden
# from the environment, e.g.:
#
#     PARTITION_TABLE=gpt BOOT_PART_SIZE_MIB=256 bazel build //platforms/rpi4:image
#
# (for the genrule, export the variables before invoking bazel, or edit the
# defaults below).

# Partition table scheme: "mbr" (classic Raspberry Pi) or "gpt" (UEFI/EBBR).
# The Pi4 GPU firmware reads the first FAT partition from either scheme.
PARTITION_TABLE="${PARTITION_TABLE:-mbr}"

# Offset of the first partition, in KiB. 1024 KiB (1 MiB) is the conventional
# alignment and leaves room for the partition table.
BOOT_PART_OFFSET_KIB="${BOOT_PART_OFFSET_KIB:-1024}"

# Size of the FAT boot partition, in MiB. Must be large enough to hold U-Boot,
# the firmware, the device tree and config.txt (FAT32 needs >= ~33 MiB).
BOOT_PART_SIZE_MIB="${BOOT_PART_SIZE_MIB:-128}"

# FAT variant: 16 or 32.
FAT_TYPE="${FAT_TYPE:-32}"

# FAT volume label (<= 11 characters).
VOLUME_LABEL="${VOLUME_LABEL:-RPI4BOOT}"
